import pandas
import numpy

# ==========================================
# Ćwiczenie 1: merge() — łączenie dwóch tabel
# ==========================================

print("--- Krok 1: prosty merge (inner) ---")
ksiazki_z_autorami = ksiazki.merge(autorzy, on='autor_id')
print(f"Shape: {ksiazki_z_autorami.shape}")
print(ksiazki_z_autorami.head())

print("\n--- Krok 2: cztery typy how ---")
# Tworzenie testowej tabeli z dodanym wierszem
ksiazki_test = pandas.concat([
    ksiazki,
    pandas.DataFrame({'ksiazka_id':[999], 'autor_id':[999],
                   'tytul':['Ksiazka bez autora'], 'kategoria':['test'],
                   'cena':[30.0], 'strony':[100]})
], ignore_index=True)

inner = ksiazki_test.merge(autorzy, on='autor_id', how='inner')
left  = ksiazki_test.merge(autorzy, on='autor_id', how='left')
right = ksiazki_test.merge(autorzy, on='autor_id', how='right')
outer = ksiazki_test.merge(autorzy, on='autor_id', how='outer')

print(f"inner:  {inner.shape[0]} wierszy")
print(f"left:   {left.shape[0]} wierszy")
print(f"right:  {right.shape[0]} wierszy")
print(f"outer:  {outer.shape[0]} wierszy")

print("\n--- Krok 3: diagnostyka z indicator=True ---")
audyt = ksiazki_test.merge(autorzy, on='autor_id', how='outer', indicator=True)
print(audyt['_merge'].value_counts())

# ==========================================
# Ćwiczenie 2: Merge łańcuchowy + kolumny wyliczane
# ==========================================

print("\n--- Krok 1: łańcuch 3 tabel ---")
pelne = (
    zamowienia
    .merge(ksiazki, on='ksiazka_id')
    .merge(autorzy, on='autor_id')
)
print(f"Pelna tabela: {pelne.shape}")

# Krok 2: Dodanie nowych kolumn wyliczanych
pelne['wartosc'] = pelne['ilosc'] * pelne['cena']
pelne['miesiac'] = pelne['data'].dt.month
pelne['autor_pelne'] = pelne['imie'] + ' ' + pelne['nazwisko']
pelne['kategoria_cenowa'] = numpy.where(pelne['cena'] >= 50, 'droga', 'tania')

print("\n--- Krok 3: pierwsze wnioski ---")
print(f"1. Wszystkich zamówień jest: {len(pelne)}")
print(f"2. Łączny przychód: {pelne['wartosc'].sum():.2f} zł")
print(f"3. Średnia wartość zamówienia: {pelne['wartosc'].mean():.2f} zł")
print(f"4. Sprzedało się {pelne['tytul'].nunique()} unikalnych tytułów.")


# ==========================================
# Ćwiczenie 3: groupby + .agg() — raporty per kategoria
# ==========================================

print("\n--- Zadanie 3a: Prosty groupby ---")
print(pelne.groupby('kategoria')['wartosc'].sum().sort_values(ascending=False))

print("\n--- Zadanie 3b: Wiele funkcji naraz ---")
print(pelne.groupby('kategoria')['wartosc'].agg(['count', 'mean', 'sum']).round(2))

print("\n--- Zadanie 3c: Named aggregation ---")
raport_autorow = pelne.groupby('autor_pelne').agg(
    liczba_zamowien=('zam_id', 'count'),
    laczna_sprzedaz=('wartosc', 'sum'),
    sredni_ilosc=('ilosc', 'mean')
).round(2).sort_values('laczna_sprzedaz', ascending=False)
print(raport_autorow)

print("\n--- Zadanie 3d: Groupby po wielu kolumnach ---")
print(pelne.groupby(['kategoria', 'kanal'])['wartosc'].sum())

# Zadanie 3e: Udział procentowy
pelne['wartosc_kat'] = pelne.groupby('kategoria')['wartosc'].transform('sum')
pelne['udzial_w_kategorii_pct'] = (pelne['wartosc'] / pelne['wartosc_kat'] * 100).round(2)


# ==========================================
# Ćwiczenie 4: pivot_table + crosstab — raport biznesowy
# ==========================================

print("\n--- Zadanie 4a & 4b: pivot_table (Kategoria x Miesiąc) ---")
pivot_przychody = pandas.pivot_table(
    pelne,
    index='kategoria',
    columns='miesiac',
    values='wartosc',
    aggfunc='sum',
    fill_value=0,
    margins=True,
    margins_name='RAZEM'
)
print(pivot_przychody)

print("\n--- Zadanie 4c: crosstab (Kanał x Miasto) ---")
print(pandas.crosstab(pelne['kanal'], pelne['miasto']))

print("\n--- Zadanie 4d: crosstab procentowy (Kanał x Miasto) ---")
crosstab_pct = pandas.crosstab(pelne['kanal'], pelne['miasto'], normalize='index') * 100
print(crosstab_pct.round(1))
