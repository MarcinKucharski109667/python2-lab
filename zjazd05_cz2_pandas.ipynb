print("\n--- Zadanie 3a: Eksploracja i rankingi ---")
print("1. TOP-5 wg przychodu:\n", filmy.nlargest(5, 'przychod_mln')[['tytul', 'przychod_mln']])
print("\n2. TOP-5 wg ROI:\n", filmy.nlargest(5, 'roi')[['tytul', 'roi']])
print("\n3. TOP-5 wg oceny IMDB:\n", filmy.nlargest(5, 'ocena_imdb')[['tytul', 'ocena_imdb']])

tanie_filmy = filmy.loc[filmy['budzet_mln'] < 15, ['tytul', 'budzet_mln', 'przychod_mln']]
print(f"\n4. Filmy z budżetem < 15 mln$ zarobiły łącznie: {tanie_filmy['przychod_mln'].sum()} mln$")
print(tanie_filmy)

print("\n--- Zadanie 3b: Pytania dyrektora ---")
filmy_akcji = filmy[filmy['gatunek'] == 'Akcja']
print(f"1. Filmów akcji jest {len(filmy_akcji)}, a ich średni ROI wynosi {filmy_akcji['roi'].mean():.2f}")

perelki = filmy.loc[(filmy['ocena_imdb'] >= 8.0) & (filmy['budzet_mln'] < 50), 'tytul'].tolist()
print("2. Perełki (ocena >= 8.0 i budżet < 50 mln$):", ", ".join(perelki))

print("3. Średni ROI per gatunek:")
for gatunek in filmy['gatunek'].unique():
    sredni_roi_gatunku = filmy.loc[filmy['gatunek'] == gatunek, 'roi'].mean()
    print(f"   - {gatunek}: {sredni_roi_gatunku:.2f}")

hity_2019_2023 = filmy.loc[filmy['rok'].between(2019, 2023) & (filmy['roi'] > 5), ['tytul', 'rok', 'roi']]
print("\n4. Filmy z lat 2019-2023 z ROI > 5:\n", hity_2019_2023)

print("\n--- Zadanie 3c: Łańcuch operacji (chaining) ---")
wynik_chaining = (filmy
    [filmy['ocena_imdb'] >= 7.5]
    .nlargest(3, 'roi')
    [['tytul', 'gatunek', 'roi', 'ocena_imdb']]
)
print(wynik_chaining)


# ==========================================
# Ćwiczenie 4: Segmentacja filmów i wizualizacja
# ==========================================

print("\n--- Zadanie 4a: Segmentacja ---")
filmy['segment'] = numpy.select(
    [filmy['roi'] > 10, filmy['roi'] > 3],
    ['Hit', 'Zyskowny'],
    default='Przeciętny'
)

print("Liczba filmów w segmentach:\n", filmy['segment'].value_counts())
print("\nŚrednia ocena IMDB per segment:")
for segment in filmy['segment'].unique():
    srednia_ocena_seg = filmy.loc[filmy['segment'] == segment, 'ocena_imdb'].mean()
    print(f"   - {segment}: {srednia_ocena_seg:.2f}")

# Wizualizacja (z wykorzystaniem pełnych nazw modułów)
fig, ax = matplotlib.pyplot.subplots(figsize=(8, 5))
kolory = {'Hit': 'green', 'Zyskowny': 'blue', 'Przeciętny': 'red'}

for seg, kolor in kolory.items():
    dane = filmy[filmy['segment'] == seg]
    ax.scatter(dane['budzet_mln'], dane['przychod_mln'],
               c=kolor, label=seg, s=60, alpha=0.7)

ax.set_xlabel('Budżet (mln $)')
ax.set_ylabel('Przychód (mln $)')
ax.set_title('Filmy: budżet vs przychód — segmentacja')
ax.legend()
matplotlib.pyplot.tight_layout()
matplotlib.pyplot.show()