print("\n--- Zadanie 1c: Strategie fillna ---")
mediana_wynagrodzenia = df['wynagrodzenie'].median()
print(f"Mediana wynagrodzenia: {mediana_wynagrodzenia}")
df['wynagrodzenie'] = df['wynagrodzenie'].fillna(mediana_wynagrodzenia)

srednia_ocena = round(df['ocena_roczna'].mean(), 2)
print(f"Średnia ocena: {srednia_ocena}")
df['ocena_roczna'] = df['ocena_roczna'].fillna(srednia_ocena)

print(f"\nPozostałe braki w kolumnach po fillna:\n{df.isna().sum()}")


print("\n--- Zadanie 1d: dropna ---")
df_bez_brakow = df.dropna(subset=['data_zatrudnienia'])
