import pandas
import numpy

# ==========================================
# ĆWICZENIE 1: Series — tworzenie i operacje
# ==========================================

# Zadanie 1a: Utwórz Series pensje z dict
pensje = pandas.Series({
    'Anna': 5500,
    'Jan': 7200,
    'Ewa': 4800,
    'Marek': 9100,
    'Kasia': 6300
})

# Zadanie 1b: Odpowiedz na pytania o pensje
print("--- Zadanie 1b ---")
print(f"1. Najwięcej zarabia: {pensje.idxmax()}")
print(f"2. Średnia pensja: {pensje.mean()}")
print(f"3. Zarabiają powyżej średniej:\n{pensje[pensje > pensje.mean()]}")
print(f"4. Liczba osób zarabiających poniżej 6000: {(pensje < 6000).sum()}")

# Zadanie 1c: Oblicz pensje po zmianach
print("\n--- Zadanie 1c ---")
pensje_podwyzka = pensje * 1.10
pensje_premia = pensje + 500
pensje_nowe = (pensje * 1.10) + 500

print(f"Ranking nowych pensji:\n{pensje_nowe.sort_values(ascending=False)}")


# ==========================================
# ĆWICZENIE 2: DataFrame — tworzenie i atrybuty
# ==========================================
# Uwaga: Zakładam, że w tym miejscu kodu masz już zdefiniowany DataFrame 'sklep'

# Zadanie 2a: Zbadaj DataFrame sklep
print("\n--- Zadanie 2a ---")
print(f"1. Kształt tabeli: {sklep.shape}")
print(f"2. Nazwy kolumn: {sklep.columns.tolist()}")
print("3. Typy danych:\n", sklep.dtypes)
print("4. Pierwsze 3 wiersze:\n", sklep.head(3))

# Zadanie 2b: Dodaj nowe kolumny do DataFrame sklep
print("\n--- Zadanie 2b ---")
sklep['wartosc_magazynu'] = sklep['cena'] * sklep['stan_magazynowy']
sklep['cena_z_vat'] = sklep['cena'] * 1.23
print("Sklep z nowymi kolumnami:\n", sklep)

# Zadanie 2c: Podstawowa eksploracja datasetu tips
print("\n--- Zadanie 2c ---")
url_tips = 'https://raw.githubusercontent.com/mwaskom/seaborn-data/master/tips.csv'
tips = pandas.read_csv(url_tips)

print(f"1. Wiersze i kolumny (shape): {tips.shape}")
print("2. Ostatnie 5 wierszy:\n", tips.tail())
print("3. Trzy losowe wiersze:\n", tips.sample(3))
print("4. Typy danych:\n", tips.dtypes)


# ==========================================
# ĆWICZENIE 3: Eksploracja datasetu
# ==========================================
url_penguins = 'https://raw.githubusercontent.com/mwaskom/seaborn-data/master/penguins.csv'
penguins = pandas.read_csv(url_penguins)

# Zadanie 3a: Pierwszy rzut oka
print("\n--- Zadanie 3a ---")
print("1. Pierwsze 10 wierszy:\n", penguins.head(10))
print(f"2. Kształt: {penguins.shape}")
print("3. Info o datasecie:")
penguins.info()

# Zadanie 3b: Statystyki opisowe
print("\n--- Zadanie 3b ---")
print("1. Statystyki liczbowe:\n", penguins.describe())
print("2. Statystyki z kolumnami tekstowymi:\n", penguins.describe(include='all'))
print(f"3. Mediana masy ciała: {penguins['body_mass_g'].median()} g")

# Zadanie 3c: Rozkłady wartości
print("\n--- Zadanie 3c ---")
print("1. Pingwiny według gatunku:\n", penguins['species'].value_counts())
print("2. Pingwiny według wyspy:\n", penguins['island'].value_counts())
print("3. Rozkład płci:\n", penguins['sex'].value_counts())
print("4. Procentowy udział gatunków:\n", penguins['species'].value_counts(normalize=True) * 100)

# Zadanie 3d: Brakujące dane
print("\n--- Zadanie 3d ---")
print("1. Brakujące wartości w kolumnach:\n", penguins.isna().sum())
procent_brakow_sex = (penguins['sex'].isna().sum() / len(penguins)) * 100
print(f"2. Procent brakujących danych w kolumnie 'sex': {procent_brakow_sex:.1f}%")


# ==========================================
# ĆWICZENIE 4: Pytania biznesowe
# ==========================================
# Przygotowanie danych z napiwkami
tips['tip_pct'] = (tips['tip'] / tips['total_bill'] * 100).round(1)

# Zadanie 4a
print("\n--- Zadanie 4a ---")
print(f"1. Średni rachunek: {tips['total_bill'].mean():.2f}")
print(f"2. Średni napiwek (%): {tips['tip_pct'].mean():.2f}%")
print("3. Liczba rachunków według dni:\n", tips['day'].value_counts())
print("4. Liczba rachunków od palaczy i niepalaczy:\n", tips['smoker'].value_counts())
print("5. Statystyki opisowe dla napiwków:\n", tips['tip'].describe())
print(f"   Mediana napiwku: {tips['tip'].median()}")
print("6. Procent rachunków z obiadu (Dinner vs Lunch):\n", tips['time'].value_counts(normalize=True) * 100)
print(f"7. Unikalne rozmiary grup: {tips['size'].nunique()}")
